{
  "name": "core-auth",
  "version": "1.4.1",
  "description": "Provider account, OAuth, and quota library for the intisy-ai AI-proxy ecosystem.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intisy-ai/core-auth.git"
  },
  "keywords": [
    "intisy-ai",
    "ai-proxy",
    "core",
    "auth",
    "oauth",
    "accounts",
    "provider"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run emit && npm run emit:teavm && npm run build:teavm && npx tsc && node node_modules/@intisy-ai/api/scripts/copy-generated.mjs",
    "build:teavm": "node node_modules/@intisy-ai/api/scripts/teavm-build.mjs --java-dir . --module :auth-teavm --out src/generated/core-auth.teavm.js",
    "test": "npm run build && vitest run",
    "prepublishOnly": "npm run build",
    "emit": "node node_modules/@intisy-ai/api/scripts/emit-dts.mjs --java-dir . --module :auth-contracts --module-dir auth-contracts --out src/generated",
    "emit:teavm": "node node_modules/@intisy-ai/api/scripts/emit-dts.mjs --java-dir . --module :auth-teavm --out src/generated"
  },
  "dependencies": {
    "@intisy-ai/api": "^1.6.0",
    "@intisy-ai/core": "^2.6.0",
    "@intisy-ai/core-ir": "^1.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^2.0.0"
  }
}
