{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "site",
  "readme": "README.md",
  "name": "@intisy-ai/core-auth",
  "excludePrivate": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "intentionallyNotExported": [
    "Menu",
    "SettingsAccessor",
    "MenuBuilder",
    "ProxyEnv",
    "__module",
    "CoreAuthJsStore"
  ],
  "highlightLanguages": ["bash", "java", "json", "ts", "typescript"],
  "ignoredHighlightLanguages": ["mermaid"],
  "sourceLinkTemplate": "https://github.com/intisy-ai/core-auth/blob/{gitRevision}/{path}#L{line}",
  "tsconfig": "./tsconfig.json"
}
